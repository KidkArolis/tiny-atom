{
  "$schema": "https://swc.rs/schema.json",
  "jsc": {
    "parser": {
      "syntax": "ecmascript",
      "jsx": true
    },
    "target": "es2022",
    "transform": {
      "react": {
        "runtime": "classic"
      }
    }
  },
  "module": {
    "type": "es6",
    "outFileExtension": "js"
  }
}
